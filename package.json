{
  "name": "yaninda-firebase-emulator-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-yaninda \"node --test firebase-tests/*.test.mjs\"",
